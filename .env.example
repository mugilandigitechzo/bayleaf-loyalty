# ---- Required in production ----
# Public address guests open from WhatsApp. Must be https:// in production.
APP_URL=https://loyalty.bayleaf.example
# postgres://user:password@host:5432/database
DATABASE_URL=postgres://bayleaf:change-me@localhost:5432/bayleaf
# 32 random bytes each, base64. Generate with: openssl rand -base64 32
# Keep them secret and backed up: losing APP_ENCRYPTION_KEY makes stored QR codes / card links unreadable
# (they can be re-issued per guest from the admin portal, but every guest would need a new link).
APP_ENCRYPTION_KEY=
APP_HASH_KEY=
# OTP delivery for guest sign-in: "webhook" (see docs/DEPLOYMENT.md). "console" is development only.
OTP_PROVIDER=webhook
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=

# ---- Optional ----
PORT=5173
HOST=0.0.0.0
# Set true when running behind a reverse proxy / load balancer that sets X-Forwarded-For.
TRUST_PROXY=true
# false | prefer | require | verify-full   (default: require in production)
DATABASE_SSL=require
# DATABASE_SSL_CA_FILE=/etc/ssl/certs/db-ca.pem
DATABASE_POOL_SIZE=10
# Country used when a guest types a local number without +country code: AE, SA, QA, KW, BH, OM, IN
DEFAULT_PHONE_REGION=AE
STAFF_SESSION_HOURS=12
CUSTOMER_SESSION_DAYS=60
# Only switch on once verified Arabic copy has been added to web/src/i18n/ar.ts
ENABLE_ARABIC=false
# Run database migrations on boot (default true)
MIGRATE_ON_START=true

# ---- First-run seed (npm run seed) ----
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_NAME=Bay Leaf Owner
# Leave empty to generate a one-time password printed by the seed script
SEED_ADMIN_PASSWORD=
SEED_OUTLET_NAME=Bay Leaf — Main
SEED_OUTLET_CODE=MAIN
